<Window x:Class="VeigarK643.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Veigar K643 Configurator"
        Width="1280"
        Height="800"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFE8EAF0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#48FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootClipHost"
          Background="Transparent"
          SizeChanged="RootClipHost_SizeChanged">
        <Border Background="#FF191B22"
                CornerRadius="12" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar. The DWM backdrop is visible through this translucent surface. -->
            <Grid Grid.Row="0">
                <Border Background="#B5222530">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D52B2F3B" Offset="0" />
                            <GradientStop Color="#A51D2029" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border VerticalAlignment="Bottom"
                        Height="1"
                        Background="#28FFFFFF" />

                <Grid>
                    <Border Width="27"
                            Height="27"
                            Margin="13,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="7"
                            Background="#FF343B59"
                            BorderBrush="#554F5B89"
                            BorderThickness="1">
                        <TextBlock Text="V"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="15"
                                   Foreground="#FFF0F1F8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-1,0,0" />
                    </Border>

                    <TextBlock Text="Veigar K643 Configurator"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#FFE6E8EF"
                               IsHitTestVisible="False" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeButton_Click"
                                ToolTip="Свернуть">
                            <Path Data="M 4,11 L 16,11"
                                  Stroke="#FFE8EAF0"
                                  StrokeThickness="1.25"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square" />
                        </Button>

                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeButton_Click"
                                ToolTip="Развернуть">
                            <Path x:Name="MaximizeGlyph"
                                  Data="M 4,4 H 16 V 16 H 4 Z"
                                  Stroke="#FFE8EAF0"
                                  StrokeThickness="1.15"
                                  Fill="Transparent" />
                        </Button>

                        <Button x:Name="CloseButton"
                                Width="44"
                                Style="{StaticResource CaptionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseButton_Click"
                                ToolTip="Скрыть в трей">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource CaptionButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE0444C" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#FFBD3038" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="M 5,5 L 15,15 M 15,5 L 5,15"
                                  Stroke="#FFE8EAF0"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Intentionally empty workspace. -->
            <Grid Grid.Row="1"
                  Background="#FF191B22" />
        </Grid>

        <Border CornerRadius="12"
                BorderBrush="#FF353945"
                BorderThickness="1"
                IsHitTestVisible="False" />
    </Grid>
</Window>
