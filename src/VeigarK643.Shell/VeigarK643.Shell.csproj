<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>VeigarK643.Shell</RootNamespace>
    <AssemblyName>Veigar K643 Configurator</AssemblyName>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\branding\key.png" Link="assets\branding\key.png" />
    <Resource Include="..\..\assets\layout\veigar-k643-layout.json" Link="assets\layout\veigar-k643-layout.json" />
  </ItemGroup>
</Project>
