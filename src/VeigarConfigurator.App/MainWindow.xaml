<Window x:Class="VeigarConfigurator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veigar K643 Configurator"
        Width="1580" Height="960" MinWidth="1320" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0C121A"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#D91A2633"/>
    <SolidColorBrush x:Key="PanelSecondaryBrush" Color="#B51F2C3A"/>
    <SolidColorBrush x:Key="LineBrush" Color="#46515F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E9EEF5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8F9CAB"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E45A63"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#593039"/>
    <SolidColorBrush x:Key="KeyBaseBrush" Color="#303A47"/>
    <SolidColorBrush x:Key="KeyTextBrush" Color="#E6ECF3"/>
    <SolidColorBrush x:Key="KeyTopEdgeBrush" Color="#72FFFFFF"/>
    <SolidColorBrush x:Key="KeyboardCanvasBrush" Color="#263241"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#1A2633"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#59697B"/>
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#405063"/>
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#E45A63"/>
    <DropShadowEffect x:Key="PanelShadow" BlurRadius="22" ShadowDepth="5" Opacity="0.24" Color="#000000"/>

    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="MinHeight" Value="31"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                      <Grid>
                        <Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource MutedBrush}"
                              StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,11,0"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ToggleButton.Background>{DynamicResource PanelSecondaryBrush}</ToggleButton.Background>
                <ToggleButton.BorderBrush>{DynamicResource LineBrush}</ToggleButton.BorderBrush>
                <ToggleButton.BorderThickness>1</ToggleButton.BorderThickness>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                Margin="10,0,28,0" VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
              <Popup x:Name="PART_Popup" Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource PanelSecondaryBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer CanContentScroll="True" MaxHeight="260"
                                Background="{DynamicResource PanelSecondaryBrush}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,5,10,5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="CheckBoxBorder" Width="13" Height="13" CornerRadius="3"
                      BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                      Background="{DynamicResource PanelSecondaryBrush}" VerticalAlignment="Center">
                <Path x:Name="CheckMark" Data="M 2,6 L 5,9 L 11,2.5" Stroke="#FFFFFF"
                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"
                                IsHitTestVisible="False" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="6" Margin="2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"
                                IsHitTestVisible="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="Width" Value="Auto"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="ScrollViewer.Background" Value="{DynamicResource PanelSecondaryBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBox}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer Focusable="False" Background="{DynamicResource PanelSecondaryBrush}"
                            Padding="0" HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}">
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="255"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Background" Value="{DynamicResource SliderTrackBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Slider}">
            <Grid Height="22">
              <Track x:Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}" Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Background="{DynamicResource AccentBrush}" BorderThickness="0"
                                Focusable="False" IsHitTestVisible="False" Opacity="0.95" Height="4"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource SliderThumbBrush}" BorderBrush="#FFFFFF"
                                BorderThickness="1" CornerRadius="7"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Background="{DynamicResource SliderTrackBrush}" BorderThickness="0"
                                Focusable="False" IsHitTestVisible="False" Height="4"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ProgressBar}">
            <Border x:Name="PART_Track" Background="{DynamicResource ScrollTrackBrush}" CornerRadius="6" ClipToBounds="True">
              <Grid>
                <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Left" CornerRadius="6"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type TabControl}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelSecondaryBrush}"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,6,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="TabBd" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PanelBorder" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Effect" Value="{StaticResource PanelShadow}"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="KeyButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
      <Setter Property="Background" Value="{Binding Brush}"/>
      <Setter Property="BorderBrush" Value="{Binding BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="ToolTip" Value="{Binding MappingName}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="KeyBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="1">
              <Border x:Name="KeyFace" Background="Transparent"
                      BorderBrush="{DynamicResource KeyTopEdgeBrush}"
                      BorderThickness="1,1,0,0" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                  TextElement.FontWeight="SemiBold"
                                  TextElement.FontSize="{TemplateBinding FontSize}"/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="KeyBorder" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="KeyFace" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="KeyBorder" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="42"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="94"/>
    </Grid.RowDefinitions>

    <!-- Product title and window theme -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="34" Height="34" Background="#4B252D" BorderBrush="#E45A63" BorderThickness="1" CornerRadius="10" Margin="0,0,11,0">
          <TextBlock Text="V" Foreground="#F2C8CB" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="VEIGAR CONFIGURATOR" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Text="RGB STUDIO  ·  K643" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="1,3,0,0"/>
        </StackPanel>
        <Border Background="{DynamicResource PanelSecondaryBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6" Margin="26,0,0,0">
          <TextBlock Text="{Binding ProfileName}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#1D4948" BorderBrush="#397F7A" BorderThickness="1" CornerRadius="14" Padding="11,6" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="#70D2C6" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ConnectionTitle}" Foreground="#B8E7E1" FontSize="10" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="11,6"/>
        <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" Margin="0" Padding="11,6"/>
      </StackPanel>
    </Grid>

    <!-- Connection message -->
    <Border Grid.Row="1" Background="{DynamicResource PanelSecondaryBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,7" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding ConnectionMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="VID 258A  ·  PID 0049  ·  MI_01 / Col08" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="68"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Navigation rail -->
      <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="7" Margin="0,0,10,0">
        <StackPanel>
          <Button Content="◈&#10;Paint" Command="{Binding SelectToolCommand}" CommandParameter="Brush" Padding="3,10" Margin="0,0,0,8"/>
          <Button Content="▦&#10;Slots" Command="{Binding SelectToolCommand}" CommandParameter="Map" Padding="3,10" Margin="0,0,0,8"/>
          <Button Content="◷&#10;Layers" Command="{Binding SelectToolCommand}" CommandParameter="Brush" Padding="3,10" Margin="0,0,0,8"/>
          <Button Content="⌘&#10;Device" Command="{Binding RefreshCommand}" Padding="3,10" Margin="0,0,0,8"/>
          <Button Content="▤&#10;Files" Command="{Binding SaveProfileCommand}" Padding="3,10" Margin="0,0,0,8"/>
          <Separator Background="{DynamicResource LineBrush}" Margin="2,18,2,14"/>
          <TextBlock Text="K643" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Main workspace with tabs -->
      <TabControl Grid.Column="1">
        <TabItem Header="PAINT">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Keyboard workspace -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,10,0" Padding="16">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="RGB STUDIO" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Paint on the map or press a physical key on the K643." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1D4948" BorderBrush="#397F7A" BorderThickness="1" CornerRadius="12" Padding="10,6">
                    <TextBlock Text="LIVE KEY INPUT" Foreground="#B8E7E1" FontSize="9" FontWeight="SemiBold"/>
                  </Border>
                </Grid>

                <!-- Paint tool strip -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                  <Button Content="Brush  B" Command="{Binding SelectToolCommand}" CommandParameter="Brush" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="Fill  G" Command="{Binding SelectToolCommand}" CommandParameter="Fill"/>
                  <Button Content="Picker  I" Command="{Binding SelectToolCommand}" CommandParameter="Picker"/>
                  <Button Content="Eraser  E" Command="{Binding SelectToolCommand}" CommandParameter="Eraser"/>
                  <Button Content="Map key" Command="{Binding SelectToolCommand}" CommandParameter="Map"/>
                  <CheckBox Content="Paint with physical keypress" IsChecked="{Binding PaintOnPhysicalPress}" Margin="10,5,0,5"/>
                </WrapPanel>

                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Border Background="{DynamicResource PanelSecondaryBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="14" MinWidth="1020">
                    <StackPanel>
                      <TextBlock Text="REDRAGON VEIGAR K643  ·  FULL KEY MAP" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="3,0,0,12"/>
                      <Grid Width="1000" Height="371" Background="{DynamicResource KeyboardCanvasBrush}">
                        <ItemsControl ItemsSource="{Binding KeyboardKeys}" Width="1000" Height="371">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas Width="1000" Height="371"/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                              <Setter Property="Canvas.Left" Value="{Binding X}"/>
                              <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Style="{StaticResource KeyButtonStyle}"
                                      Width="{Binding Width}" Height="{Binding Height}"
                                      Content="{Binding Label}"
                                      Command="{Binding DataContext.SelectKeyboardKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding KeyId}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </StackPanel>
                  </Border>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="34" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8">
                      <TextBlock Text="{Binding SelectedKeyboardKeyLabel}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SelectedKeyboardKeyStatus}" Foreground="{DynamicResource TextBrush}" FontSize="10" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding LastDetectedKey}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Text="{Binding OperationMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </Border>

            <!-- Color, layers and selection inspector -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="15">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="INSPECTOR" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="Selection" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SelectedKeyboardKeyLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,14"/>

                  <TextBlock Text="KEY COLOUR" Style="{StaticResource SectionLabel}"/>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="10" Background="{Binding PreviewBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="OUTPUT PREVIEW" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold"/>
                      <TextBlock Text="{Binding EffectiveColorHex}" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="HEX VALUE" Style="{StaticResource SectionLabel}"/>
                  <DockPanel Margin="0,0,0,14">
                    <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}" Width="116" MaxLength="7" VerticalContentAlignment="Center"/>
                    <Button Content="Apply" Command="{Binding ApplyHexCommand}" Margin="8,0,0,0"/>
                  </DockPanel>

                  <TextBlock Text="PALETTE" Style="{StaticResource SectionLabel}"/>
                  <UniformGrid Columns="4" Margin="0,0,0,15">
                    <Button Content="Coral" Background="#9F333D" Command="{Binding SendPresetCommand}" CommandParameter="F24D57" Padding="5"/>
                    <Button Content="Amber" Background="#86632F" Command="{Binding SendPresetCommand}" CommandParameter="F7BA5C" Padding="5"/>
                    <Button Content="Green" Background="#315C45" Command="{Binding SendPresetCommand}" CommandParameter="5FC888" Padding="5"/>
                    <Button Content="Teal" Background="#286B6D" Command="{Binding SendPresetCommand}" CommandParameter="50C7C5" Padding="5"/>
                    <Button Content="Blue" Background="#315B91" Command="{Binding SendPresetCommand}" CommandParameter="528EE8" Padding="5"/>
                    <Button Content="Violet" Background="#594884" Command="{Binding SendPresetCommand}" CommandParameter="9A75E4" Padding="5"/>
                    <Button Content="White" Background="#626E7C" Command="{Binding SendPresetCommand}" CommandParameter="FFFFFF" Padding="5"/>
                    <Button Content="Off" Background="#252D37" Command="{Binding SendPresetCommand}" CommandParameter="000000" Padding="5"/>
                  </UniformGrid>

                  <TextBlock Text="RGB CHANNELS" Style="{StaticResource SectionLabel}"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="R" Foreground="#E87980" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Slider Grid.Row="0" Grid.Column="1" Maximum="255" Value="{Binding RedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RedValue, StringFormat={}{0:F0}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9"/>
                    <TextBlock Grid.Row="1" Text="G" Foreground="#75CB92" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Slider Grid.Row="1" Grid.Column="1" Maximum="255" Value="{Binding GreenValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GreenValue, StringFormat={}{0:F0}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9"/>
                    <TextBlock Grid.Row="2" Text="B" Foreground="#78AAE7" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Slider Grid.Row="2" Grid.Column="1" Maximum="255" Value="{Binding BlueValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BlueValue, StringFormat={}{0:F0}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9"/>
                  </Grid>
                  <DockPanel Margin="0,2,0,6">
                    <TextBlock Text="BRIGHTNESS" Style="{StaticResource SectionLabel}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BrightnessValue, StringFormat={}{0:F0}%}" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="9"/>
                  </DockPanel>
                  <Slider Minimum="0" Maximum="100" Value="{Binding BrightnessValue, Mode=TwoWay}" Margin="0,0,0,12"/>

                  <Separator Background="{DynamicResource LineBrush}" Margin="0,5,0,12"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="LIGHTING LAYERS" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="Compose your scene" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ Layer" Command="{Binding AddLayerCommand}" Margin="0" Padding="9,5"/>
                  </Grid>
                  <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}" Height="132" Margin="0,8,0,10">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="1">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Mode}" FontSize="8" Foreground="{DynamicResource MutedBrush}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0}%}" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel>
                    <Button Content="Remove" Command="{Binding RemoveLayerCommand}"/>
                    <Button Content="Move ↑" Command="{Binding MoveLayerUpCommand}"/>
                    <Button Content="Move ↓" Command="{Binding MoveLayerDownCommand}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding OperationMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="CALIBRATION">
          <Border Style="{StaticResource PanelBorder}" Padding="20" Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="PHYSICAL KEY CALIBRATION" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Measured physical keyboard map · 94 mapped keys" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="The supplied LED test table is now built in: 94 physical keys are associated with their measured protocol LED slots. The remaining 32 of 126 slots had no confirmed physical key in the source table. Select a slot to inspect its key; custom capture can override the measured mapping." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="620" Margin="0,0,0,18"/>
                <TextBlock Text="{Binding SelectedSlotLabel}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedSlotMapping}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,14"/>
                <WrapPanel>
                  <Button Content="Capture physical key" Command="{Binding ArmMappingCommand}" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="Clear mapping" Command="{Binding ClearMappingCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding LastDetectedKey}" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding MappingsCount, StringFormat=Measured physical keys: {0}}" FontSize="12" Margin="0,14,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="LED SLOT MATRIX" Style="{StaticResource SectionLabel}"/>
                <ItemsControl ItemsSource="{Binding LedSlots}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Label}" Background="{Binding Brush}"
                              Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding SlotIndex}" Padding="2" Margin="2" MinWidth="27" Height="28" FontSize="8"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Map a selected physical key to the currently selected LED slot using the Map tool on the Paint tab." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,14,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </TabItem>

        <TabItem Header="ANIMATION">
          <Border Style="{StaticResource PanelBorder}" Padding="20" Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="ANIMATION WORKSPACE" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Build a timeline from captured lighting frames." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Choose the Animation layer type, capture the current lighting scene as a frame, and set the duration of each frame in the layer data. Play the animation to preview the sequence on the connected keyboard." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,18"/>
                <ComboBox ItemsSource="{Binding AvailableLayerTypes}" SelectedItem="{Binding SelectedLayerType}" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <WrapPanel>
                  <Button Content="Add animation layer" Command="{Binding AddLayerCommand}" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="Add frame" Command="{Binding AddAnimationFrameCommand}"/>
                  <Button Content="Remove last frame" Command="{Binding RemoveAnimationFrameCommand}"/>
                  <Button Content="{Binding AnimationButtonText}" Command="{Binding ToggleAnimationCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding OperationMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="22,0,0,0">
                <TextBlock Text="ANIMATION FILE" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Portable project format" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text=".vca contains animation layers and their captured frames. It remains editable and can be reloaded into the configurator." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,16"/>
                <WrapPanel>
                  <Button Content="Save .vca" Command="{Binding SaveAnimationCommand}" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="Open .vca" Command="{Binding LoadAnimationCommand}"/>
                </WrapPanel>
                <TextBlock Text="Paint projects use .vcp. Both formats are local JSON-based project files; neither writes firmware." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </TabItem>

        <TabItem Header="AUDIO">
          <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,10,0" MaxWidth="800" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="AUDIO-REACTIVE LIGHTING" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="Windows default output peak" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="The app samples the default Windows audio endpoint peak meter only. No audio is recorded or stored." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,15"/>
              <CheckBox Content="Enable audio-reactive lighting" IsChecked="{Binding AudioReactiveEnabled}"/>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding AudioPeakLevel, Mode=OneWay}" Height="12" Margin="0,13,0,10"/>
              <TextBlock Text="{Binding AudioStatus}" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </Border>
        </TabItem>

        <TabItem Header="PROFILES">
          <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,10,0" MaxWidth="780" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="LOCAL PROJECT FILES" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="Save the complete lighting workspace" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text=".vcp stores the colour scene, all lighting layers, calibrated physical-key mappings, slot colours and animation data. Older .json colour profiles remain supported for import." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,18"/>
              <TextBlock Text="PROJECT NAME" Style="{StaticResource SectionLabel}"/>
              <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
              <WrapPanel>
                <Button Content="Save .vcp" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Open .vcp" Command="{Binding LoadProfileCommand}"/>
              </WrapPanel>
              <TextBlock Text="Projects are stored locally. Lighting changes are temporary and no firmware modification is performed." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- File actions and status -->
    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0" Effect="{StaticResource PanelShadow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="PROJECT" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold"/>
          <TextBlock Text="{Binding ProfileName}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
          <Button Content="Save .vcp" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}"/>
          <Button Content="Open .vcp" Command="{Binding LoadProfileCommand}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
          <Button Content="Save .vca" Command="{Binding SaveAnimationCommand}"/>
          <Button Content="Open .vca" Command="{Binding LoadAnimationCommand}"/>
        </StackPanel>
        <TextBlock Grid.Column="3" Text="LOCAL PROJECTS  ·  USB HID ONLY  ·  NO KEYSTROKE LOGGING  ·  NO AUDIO RECORDING  ·  NO TELEMETRY"
                   Foreground="{DynamicResource MutedBrush}" FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock Text="{Binding FooterStatus}" Foreground="{DynamicResource TextBrush}" FontSize="10" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding OperationMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="8" MaxWidth="250" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
