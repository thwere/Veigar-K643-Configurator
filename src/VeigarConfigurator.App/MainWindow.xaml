<Window x:Class="VeigarConfigurator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veigar K643 Configurator"
        Width="1360" Height="900" MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#101216" Foreground="#E9EBEF" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#191C21"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#969EAA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#D52B36"/>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#F4F5F7"/>
      <Setter Property="Background" Value="#292E36"/>
      <Setter Property="BorderBrush" Value="#424A56"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="#F2F4F7"/>
      <Setter Property="Background" Value="#242932"/>
      <Setter Property="BorderBrush" Value="#3D4652"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="#F2F4F7"/>
      <Setter Property="Background" Value="#242932"/>
      <Setter Property="BorderBrush" Value="#3D4652"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="#F2F4F7"/>
      <Setter Property="Background" Value="#242932"/>
      <Setter Property="Padding" Value="8,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3A414C"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#4A252B"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="#DCE0E6"/>
      <Setter Property="Margin" Value="0,4,12,6"/>
    </Style>
    <Style TargetType="{x:Type ListBox}">
      <Setter Property="Foreground" Value="#E9EBEF"/>
      <Setter Property="Background" Value="#171A1F"/>
      <Setter Property="BorderBrush" Value="#343A44"/>
      <Setter Property="Padding" Value="5"/>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
      <Setter Property="Foreground" Value="#E9EBEF"/>
      <Setter Property="Background" Value="#20242B"/>
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4A252B"/>
          <Setter Property="BorderBrush" Value="#D52B36"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type TabControl}">
      <Setter Property="Background" Value="#101216"/>
      <Setter Property="BorderBrush" Value="#343A44"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="#ADB4BF"/>
      <Setter Property="Background" Value="#1B1F25"/>
      <Setter Property="Padding" Value="17,10"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="Background" Value="#292E36"/>
          <Setter Property="BorderBrush" Value="#D52B36"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Panel" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="#343A44"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
    <Style x:Key="ChannelSlider" TargetType="{x:Type Slider}">
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="255"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="Margin" Value="10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="VEIGAR CONFIGURATOR" FontSize="24" FontWeight="Bold" Foreground="#F6F7F9"/>
        <TextBlock Text="Redragon Veigar K643 · RGB Studio · Experimental v0.3" Foreground="#969EAA" FontSize="12" Margin="1,4,0,0"/>
      </StackPanel>
      <TextBlock Text="VKC" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#D52B36" FontSize="15" FontWeight="Bold"/>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding ConnectionTitle}" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ConnectionMessage}" Foreground="#9AA2AE" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="VID 258A · PID 0049 · MI_01 / Col08" Foreground="#AAB1BC" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="REFRESH" Command="{Binding RefreshCommand}" Margin="0" Padding="12,6"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="2">
      <TabItem Header="LED EDITOR">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="126-SLOT RGB MATRIX" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Select an LED slot to edit its colour. This is the protocol slot grid, not yet a verified physical key layout." Foreground="#A0A8B4" TextWrapping="Wrap" FontSize="11"/>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding LedSlots}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Label}" Background="{Binding Brush}" ToolTip="{Binding MappingName}"
                              Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding SlotIndex}" Padding="2" Margin="2" MinWidth="35" Height="34" FontSize="9"
                              BorderBrush="#505864" BorderThickness="1"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{Binding SelectedSlotLabel}" Foreground="#F2F4F7" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedSlotMapping}" Foreground="#9AA2AE" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="COLOUR &amp; BRIGHTNESS" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Height="74" CornerRadius="8" Background="{Binding PreviewBrush}" BorderBrush="#535B67" BorderThickness="1"/>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="OUTPUT PREVIEW" Foreground="#9AA2AE" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding EffectiveColorHex}" FontFamily="Consolas" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="HEX COLOUR" Style="{StaticResource SectionLabel}"/>
                <DockPanel Margin="0,0,0,16">
                  <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}" Width="126" MaxLength="7" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                  <Button Content="APPLY HEX" Command="{Binding ApplyHexCommand}" Margin="9,0,0,0"/>
                </DockPanel>
                <TextBlock Text="RGB CHANNELS" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,12">
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="#E87980" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource ChannelSlider}" Value="{Binding RedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RedValue, StringFormat={}{0:F0}}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="#75CB92" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource ChannelSlider}" Value="{Binding GreenValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GreenValue, StringFormat={}{0:F0}}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="#78AAE7" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource ChannelSlider}" Value="{Binding BlueValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BlueValue, StringFormat={}{0:F0}}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <DockPanel Margin="0,0,0,5">
                  <TextBlock Text="BRIGHTNESS" Style="{StaticResource SectionLabel}"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding BrightnessValue, StringFormat={}{0:F0}}" Foreground="#C9CED6" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="%" Foreground="#C9CED6" FontSize="11"/>
                  </StackPanel>
                </DockPanel>
                <Slider Minimum="0" Maximum="100" Value="{Binding BrightnessValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
                <TextBlock Text="QUICK PRESETS" Style="{StaticResource SectionLabel}"/>
                <WrapPanel>
                  <Button Content="RED" Background="#8F2027" Command="{Binding SendPresetCommand}" CommandParameter="FF2020"/>
                  <Button Content="ORANGE" Background="#95531E" Command="{Binding SendPresetCommand}" CommandParameter="FF8A20"/>
                  <Button Content="YELLOW" Background="#80711D" Command="{Binding SendPresetCommand}" CommandParameter="FFE83A"/>
                  <Button Content="GREEN" Background="#24643F" Command="{Binding SendPresetCommand}" CommandParameter="20D878"/>
                  <Button Content="CYAN" Background="#216C75" Command="{Binding SendPresetCommand}" CommandParameter="20DDE0"/>
                  <Button Content="BLUE" Background="#244D83" Command="{Binding SendPresetCommand}" CommandParameter="287BDF"/>
                  <Button Content="VIOLET" Background="#623D82" Command="{Binding SendPresetCommand}" CommandParameter="A45BDE"/>
                  <Button Content="WHITE" Background="#64666A" Command="{Binding SendPresetCommand}" CommandParameter="FFFFFF"/>
                </WrapPanel>
                <WrapPanel Margin="0,9,0,0">
                  <Button Content="SET SELECTED SLOT" Command="{Binding ApplySlotColorCommand}"/>
                  <Button Content="FILL ALL 126 SLOTS" Command="{Binding FillAllSlotsCommand}"/>
                  <Button Content="SEND SCENE" Background="#8B222B" Command="{Binding SendSceneCommand}"/>
                  <Button Content="LIGHTS OFF" Command="{Binding SendPresetCommand}" CommandParameter="000000"/>
                </WrapPanel>
                <TextBlock Text="{Binding OperationMessage}" Foreground="#C7CDD6" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="LAYERS &amp; ANIMATION">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="LIGHTING STACK" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Layers are composited from bottom to top. Enable, reorder or remove them." Foreground="#9AA2AE" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ComboBox ItemsSource="{Binding AvailableLayerTypes}" SelectedItem="{Binding SelectedLayerType}" Margin="0,0,0,10"/>
                <Button Content="ADD LAYER" Command="{Binding AddLayerCommand}" HorizontalAlignment="Left"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Mode}" Foreground="#9AA2AE" FontSize="10"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Content="REMOVE" Command="{Binding RemoveLayerCommand}"/>
                <Button Content="MOVE UP" Command="{Binding MoveLayerUpCommand}"/>
                <Button Content="MOVE DOWN" Command="{Binding MoveLayerDownCommand}"/>
              </WrapPanel>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="SELECTED LAYER" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding SelectedLayer.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                <TextBlock Text="BLEND MODE" Style="{StaticResource SectionLabel}"/>
                <ComboBox ItemsSource="{Binding BlendModes}" SelectedItem="{Binding SelectedLayer.BlendMode, Mode=TwoWay}" Margin="0,0,0,14"/>
                <TextBlock Text="LAYER OPACITY" Style="{StaticResource SectionLabel}"/>
                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedLayer.Opacity, Mode=TwoWay}" Margin="0,0,0,16"/>
                <TextBlock Text="COLOUR SOURCE" Style="{StaticResource SectionLabel}"/>
                <WrapPanel>
                  <Button Content="SET START FROM EDITOR" Command="{Binding SetLayerStartColorCommand}"/>
                  <Button Content="SET END FROM EDITOR" Command="{Binding SetLayerEndColorCommand}"/>
                </WrapPanel>
                <TextBlock Text="ANIMATION TIMELINE" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                <TextBlock Text="Add a frame to capture the current 126-slot scene. Animation frames cycle using their stored durations." Foreground="#9AA2AE" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel>
                  <Button Content="ADD FRAME" Command="{Binding AddAnimationFrameCommand}"/>
                  <Button Content="REMOVE LAST FRAME" Command="{Binding RemoveAnimationFrameCommand}"/>
                  <Button Content="{Binding AnimationButtonText}" Command="{Binding ToggleAnimationCommand}" Background="#7D252E"/>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="KEY REACTIONS">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="PHYSICAL KEY CALIBRATION" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="{Binding SelectedSlotLabel}" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Select a slot in LED EDITOR, arm capture, then press the matching physical key on the K643. The mapping is stored in your local profile." Foreground="#9AA2AE" TextWrapping="Wrap" Margin="0,10,0,16"/>
              <TextBlock Text="{Binding SelectedSlotMapping}" Foreground="#D3D7DE" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <WrapPanel>
                <Button Content="{Binding MappingButtonText}" Command="{Binding ArmMappingCommand}" Background="#7D252E"/>
                <Button Content="CLEAR SLOT MAPPING" Command="{Binding ClearMappingCommand}"/>
              </WrapPanel>
              <TextBlock Text="{Binding LastDetectedKey}" Foreground="#AAB2BE" Margin="0,14,0,0"/>
              <TextBlock Text="CALIBRATED SLOT MAPPINGS" Foreground="#818A97" FontSize="10" Margin="0,8,0,0"/>
              <TextBlock Text="{Binding MappingsCount}" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="KEY-PRESS EFFECTS" Style="{StaticResource SectionLabel}"/>
              <CheckBox Content="Enable key-reactive lighting" IsChecked="{Binding KeyReactiveEnabled}"/>
              <TextBlock Text="Raw Input listens only to USB VID 258A / PID 0049. Key text is never stored or logged." Foreground="#9AA2AE" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,16"/>
              <TextBlock Text="EFFECT MODE" Style="{StaticResource SectionLabel}"/>
              <ComboBox ItemsSource="{Binding KeyEffectOptions}" SelectedItem="{Binding SelectedKeyEffect, Mode=TwoWay}" Margin="0,0,0,14"/>
              <TextBlock Text="Flash, fade and hold glow are available. Simultaneous mapped keys are processed independently. Ripple and neighbour ripple await a verified physical geometry map." Foreground="#818A97" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="AUDIO">
        <Grid Margin="12">
          <Border Style="{StaticResource Panel}" MaxWidth="850" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="AUDIO-REACTIVE LIGHTING" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="Windows default output meter" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Audio level is read from the Windows Core Audio endpoint peak meter. The app does not record, save or transmit audio." Foreground="#9AA2AE" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,18"/>
              <CheckBox Content="Enable audio-reactive lighting" IsChecked="{Binding AudioReactiveEnabled}"/>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding AudioPeakLevel, Mode=OneWay}" Height="14" Margin="0,12,0,10"/>
              <TextBlock Text="{Binding AudioStatus}" Foreground="#BBC2CC" FontSize="11"/>
              <TextBlock Text="This build scales the audio layer by output peak. Frequency-band and spectrum effects remain a later step." Foreground="#818A97" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="PROFILES">
        <Grid Margin="12">
          <Border Style="{StaticResource Panel}" MaxWidth="780" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="LOCAL PROFILE LIBRARY" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="Save the complete lighting workspace" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="Profiles include the layer stack, 126 slot colours, animation frames and calibrated key-to-slot assignments. Profiles are local JSON files." Foreground="#9AA2AE" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,18"/>
              <TextBlock Text="PROFILE NAME" Style="{StaticResource SectionLabel}"/>
              <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
              <WrapPanel>
                <Button Content="SAVE PROFILE" Command="{Binding SaveProfileCommand}"/>
                <Button Content="LOAD PROFILE" Command="{Binding LoadProfileCommand}"/>
              </WrapPanel>
              <TextBlock Text="Loading a profile updates the editor; press SEND SCENE to transmit it. Previous v0.2.0-alpha single-colour profiles are migrated on load." Foreground="#818A97" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="ROADMAP">
        <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Panel}" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="INTEGRATED IN THIS ALPHA" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="• Per-slot RGB editing for 126 protocol slots&#10;• Static, gradient, animation, audio-reactive and key-reactive layers&#10;• Layer opacity and Replace / Add / Max compositing&#10;• Animation frame capture and playback&#10;• Raw Input filtered to the K643 VID/PID&#10;• Manual physical-key-to-slot calibration&#10;• Flash, fade, hold glow and simultaneous key responses&#10;• JSON profiles with layers, frames and key mappings" Foreground="#C8CFD9" Margin="0,10,0,22" TextWrapping="Wrap"/>
              <TextBlock Text="NEXT MODULES" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="• Verified physical layout and neighbour relationships&#10;• Ripple / neighbour-ripple effects&#10;• Frequency-band audio visualisation&#10;• Dedicated macro editor and safe playback&#10;• Software key remapping with explicit enable / disable&#10;• Installer, updater and diagnostics" Foreground="#AAB3C0" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="3" Margin="0,15,0,0">
      <TextBlock Text="DARK UI · LOCAL USB ONLY · NO KEYSTROKE LOGGING · NO AUDIO RECORDING · NO TELEMETRY" Foreground="#707986" FontSize="9" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding FooterStatus}" Foreground="#AAB2BE" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
